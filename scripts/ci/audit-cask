#!/bin/sh
set -eu

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

[ $# -ge 1 ] || fail "usage: ${0##*/} <cask.rb> [wisp-<version>-<arch>.zip...]"
cask_file=$1
shift
[ -f "$cask_file" ] || fail "$cask_file does not exist"
for zip in "$@"; do
  [ -f "$zip" ] || fail "$zip does not exist"
done
command -v brew >/dev/null || fail "Homebrew is required"

tap=wisp-ci/dry-run
cask=$tap/wisp
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1

# A throwaway download cache and tap keep a local run from touching the user's own Homebrew state.
work=$(mktemp -d)
export HOMEBREW_CACHE="$work/cache"
installed=no
cleanup() {
  status=$?
  if [ "$installed" = yes ]; then
    brew uninstall --cask "$cask" || status=1
  fi
  brew untrust --cask "$cask" >/dev/null 2>&1 || true
  brew untap "$tap" >/dev/null 2>&1 || true
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

brew untap "$tap" >/dev/null 2>&1 || true
brew tap-new --no-git "$tap" >&2
mkdir -p "$(brew --repository "$tap")/Casks"
cp "$cask_file" "$(brew --repository "$tap")/Casks/wisp.rb"

set -x
brew --version
brew style --cask "$cask"
brew audit --cask --strict --arch=all "$cask"
set +x

if [ $# -eq 0 ]; then
  echo "${0##*/}: no zip given, so the download audits and the install check were skipped" >&2
  exit 0
fi

host_zip=
host_arch=$(uname -m)
for zip in "$@"; do
  arch=${zip##*-}
  arch=${arch%.zip}
  case $arch in
    arm64) brew_arch=arm ;;
    x64) brew_arch=intel ;;
    *) fail "$zip is not named wisp-<version>-<arm64|x64>.zip" ;;
  esac
  cached=$(brew --cache --cask --arch="$brew_arch" "$cask")
  mkdir -p "$(dirname "$cached")"
  cp "$zip" "$cached"
  set -x
  brew audit --cask --online --only=min_os,artifact_case,rosetta --arch="$brew_arch" "$cask"
  set +x
  if [ "$arch" = "$host_arch" ] || { [ "$arch" = x64 ] && [ "$host_arch" = x86_64 ]; }; then
    host_zip=$zip
  fi
done

if [ -z "$host_zip" ]; then
  echo "${0##*/}: no zip for this Mac's architecture ($host_arch), so the install check was skipped" >&2
  exit 0
fi
if brew list --cask wisp >/dev/null 2>&1; then
  echo "${0##*/}: a wisp cask is already installed here, so the install check was skipped to leave it alone" >&2
  exit 0
fi

version=${host_zip##*/}
version=${version#wisp-}
version=${version%-*}
appdir="$work/Applications"
mkdir -p "$appdir"
installed=yes
set -x
brew install --cask --appdir="$appdir" "$cask"
codesign --verify --deep --strict "$appdir/wisp.app"
set +x
actual=$(plutil -extract CFBundleShortVersionString raw -o - "$appdir/wisp.app/Contents/Info.plist")
[ "$actual" = "$version" ] || fail "installed wisp.app is version $actual, expected $version"
xattr -p com.apple.quarantine "$appdir/wisp.app" >/dev/null ||
  fail "Homebrew did not quarantine wisp.app, so this check no longer matches what users get"
echo "${0##*/}: installed wisp $version from the cask, quarantined as users will get it; uninstalling" >&2
