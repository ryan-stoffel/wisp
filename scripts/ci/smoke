#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
node "$root/scripts/ci/release/node-version.js" "${0##*/}"

set -x

node --version
# ci/smoke imports playwright-core only as a type; at runtime it comes through ci/screenshots/src/harness.ts,
# which resolves it from ci/screenshots' node_modules.
(cd "$root/ci/screenshots" && npm ci --omit=dev --no-audit --no-fund)
node "$root/ci/smoke/src/run.ts"
