#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
node "$root/scripts/ci/release/node-version.js" "${0##*/}"

set -x

node --version
# ci/screenshots/src/harness.ts's "playwright-core" import resolves from ci/screenshots' node_modules.
(cd "$root/ci/screenshots" && npm ci --no-audit --no-fund)
cd "$root/ci/smoke"
npm ci --no-audit --no-fund
npm run lint
npm run typecheck
npm test
