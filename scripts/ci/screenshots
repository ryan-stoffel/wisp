#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
node "$root/scripts/ci/release/node-version.js" "${0##*/}"

out=${1:-$root/ci/screenshots/out}
mkdir -p "$out"
out=$(cd "$out" && pwd)

cd "$root/ci/screenshots"
set -x

node --version
npm ci --omit=dev --no-audit --no-fund
node src/capture.ts "$out"
