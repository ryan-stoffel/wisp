#!/bin/sh
set -eu

usage="usage: ${0##*/} [<out-dir>] --request '<mode>: <scene>[, <scene>...][; ...]'"
root=$(cd "$(dirname "$0")/../.." && pwd)
want=$(cut -d. -f1 "$root/.nvmrc")
have=$(node -p 'process.versions.node.split(".")[0]')
if [ "$have" != "$want" ]; then
  echo "${0##*/}: Node $want is required (.nvmrc pins $(cat "$root/.nvmrc")), but node is $(node --version)" >&2
  exit 1
fi

out=$root/ci/screenshots/out
case ${1:-} in
  '') echo "$usage" >&2; exit 1 ;;
  -*) ;;
  *) out=$1; shift ;;
esac
mkdir -p "$out"
out=$(cd "$out" && pwd)

cd "$root/ci/screenshots"
set -x

node --version
npm ci --omit=dev --no-audit --no-fund
# recordVideo encodes with Playwright's own ffmpeg build, which is a separate download.
case "$*" in
  *video:*) npx --no-install playwright-core install ffmpeg ;;
esac
node src/capture.ts "$out" "$@"
