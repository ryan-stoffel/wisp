#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
node "$root/scripts/ci/release/node-version.js" "${0##*/}"
: "${WISP_APP_BUNDLE:?WISP_APP_BUNDLE must point at a built Wisp.app (scripts/ci/README.md)}"

set -x

node --version
# ci/e2e imports playwright-core only as a type; at runtime it comes through ci/screenshots/src/harness.ts,
# which resolves it from ci/screenshots' node_modules.
(cd "$root/ci/screenshots" && npm ci --omit=dev --no-audit --no-fund)

status_file=$(mktemp "${TMPDIR:-/tmp}/wisp-e2e-ssh-status.XXXXXX")
# Stops ssh-localhost's sshd once the checks that use it have finished.
stop_sshd() {
  sshd_pid=$(grep '^WISP_E2E_SSHD_PID=' "$status_file" 2>/dev/null | cut -d= -f2- || true)
  [ -n "$sshd_pid" ] && kill "$sshd_pid" 2>/dev/null
  return 0
}
trap stop_sshd EXIT

"$root/scripts/ci/ssh-localhost" "$status_file"
"$root/scripts/ci/check-ssh-attach" "$status_file" "$WISP_APP_BUNDLE/Contents/Resources/app/bin/wispd"

WISP_E2E_SSH_STATUS_FILE=$status_file node "$root/ci/e2e/src/run.ts"
