#!/bin/sh
set -eu

usage="usage: ${0##*/} <version> [arm64|x64]"
fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

[ $# -ge 1 ] && [ $# -le 2 ] || fail "$usage"
version=$1
printf '%s\n' "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' ||
  fail "version must be MAJOR.MINOR.PATCH, got '$version'"
case ${2:-$(uname -m)} in
  arm64) arch=arm64 ;;
  x64 | x86_64) arch=x64 ;;
  *) fail "arch must be arm64 or x64, got '${2:-$(uname -m)}'" ;;
esac
[ "$(uname -s)" = Darwin ] || fail "packaging needs macOS"

root=$(cd "$(dirname "$0")/../.." && pwd)
want=$(cut -d. -f1 "$root/.nvmrc")
have=$(node -p 'process.versions.node.split(".")[0]')
[ "$have" = "$want" ] || fail "Node $want is required (.nvmrc pins $(cat "$root/.nvmrc")), but node is $(node --version)"
fixture="$root/ci/fixtures/electron-smoke"
bundle_id=io.github.ryan-stoffel.wisp
bundle="$root/dist/wisp-darwin-$arch/wisp.app"
zip="$root/dist/wisp-$version-$arch.zip"

# The version is stamped into the checkout only; put the files back so it is never committed.
saved=$(mktemp -d)
cp "$fixture/package.json" "$fixture/package-lock.json" "$saved/"
trap 'cp "$saved/package.json" "$saved/package-lock.json" "$fixture/"; rm -rf "$saved"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

set -x
cd "$fixture"
npm version "$version" --no-git-tag-version --allow-same-version --ignore-scripts >&2
npm pkg set productName=wisp >&2
"$root/scripts/ci/build-app" >&2

rm -rf "$(dirname "$bundle")" "$zip"
npx --no electron-packager . wisp \
  --platform=darwin --arch="$arch" --out="$root/dist" \
  --app-version="$version" --build-version="$version" \
  --app-bundle-id="$bundle_id" --app-category-type=public.app-category.developer-tools \
  --ignore='^/(?!(?:package\.json|out|static)(?:/|$))' >&2

# Packager leaves Electron's per-binary signatures, which no longer match the renamed bundle.
# Without a valid signature, Gatekeeper reports the app as damaged and offers no Open Anyway.
codesign --force --deep --sign - "$bundle"
codesign --verify --deep --strict "$bundle"
set +x

plist="$bundle/Contents/Info.plist"
for pair in "CFBundleShortVersionString=$version" "CFBundleVersion=$version" "CFBundleIdentifier=$bundle_id"; do
  key=${pair%%=*}
  actual=$(plutil -extract "$key" raw -o - "$plist")
  [ "$actual" = "${pair#*=}" ] || fail "$key is '$actual' in $plist, expected '${pair#*=}'"
done

ditto -c -k --keepParent --norsrc --noextattr --noacl "$bundle" "$zip"
echo "${0##*/}: wrote $zip" >&2
printf '%s\n' "$bundle"
