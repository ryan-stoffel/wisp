#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: scripts/editor/build-app [--app-version <X.Y.Z>] [arm64|x64]

Builds the packaged app for macOS on arm64 or x64 (default: this Mac's
architecture) with upstream's gulp task vscode-darwin-<arch>-min, ad-hoc signs
it, and prints the path of editor/VSCode-darwin-<arch>/<name>.app as the only
line on stdout. Everything else goes to stderr.

Steps: scripts/editor/prepare, then npm ci for <arch> unless node_modules
already matches, the built-in extensions, gulp, codesign, and upstream's check
of every Mach-O file's architecture. x64 builds on Apple silicon too, as
upstream's pipeline does. GITHUB_TOKEN, if set, is passed to upstream's GitHub
downloads (built-in extensions and Electron). scripts/ci/check-app checks the
branding of the result.

  --app-version <X.Y.Z>  build with this version instead of upstream's, as
                         scripts/ci/package-app does for a release. Gulp puts it
                         in the app's product.json, which the About dialog and
                         wisp --version show, and in CFBundleShortVersionString
                         and CFBundleVersion. editor/vscode/package.json holds it
                         only while gulp runs.
EOF
}

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

app_version=
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    --app-version)
      [ $# -ge 2 ] || fail "--app-version needs a version"
      app_version=$2
      shift 2
      ;;
    --app-version=*)
      app_version=${1#*=}
      shift
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *) break ;;
  esac
done
[ $# -le 1 ] || {
  usage >&2
  exit 2
}
if [ -n "$app_version" ]; then
  printf '%s\n' "$app_version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' ||
    fail "--app-version must be MAJOR.MINOR.PATCH, got '$app_version'"
fi
case ${1:-$(uname -m)} in
  arm64) arch=arm64 ;;
  x64 | x86_64) arch=x64 ;;
  *) fail "arch must be arm64 or x64, got '${1:-$(uname -m)}'" ;;
esac
[ "$(uname -s)" = Darwin ] || fail "building the app needs macOS"

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
want=$(cut -d. -f1 "$root/.nvmrc")
have=$(node -p 'process.versions.node.split(".")[0]')
[ "$have" = "$want" ] || fail "Node $want is required (.nvmrc pins $(cat "$root/.nvmrc")), but node is $(node --version)"

"$here/prepare" >&2
cd "$root/editor/vscode"

# Native modules follow npm_config_arch, so node_modules belongs to one target at a time.
install_key=$(node build/azure-pipelines/common/computeNodeModulesCacheKey.ts darwin "$arch" "$(node -p process.arch)" "$(node --version)")
if [ "$(cat node_modules/.wisp-install 2>/dev/null || true)" = "$install_key" ]; then
  echo "${0##*/}: node_modules is already installed for darwin-$arch" >&2
else
  echo "${0##*/}: installing node_modules for darwin-$arch" >&2
  npm_config_arch=$arch ELECTRON_SKIP_BINARY_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    GYP_DEFINES=kerberos_use_rtld=false npm ci --no-audit --no-fund >&2
  printf '%s\n' "$install_key" >node_modules/.wisp-install
fi

npm run download-builtin-extensions >&2
if [ -n "$app_version" ]; then
  # Gulp takes the version from package.json. Put the file back afterwards, or the
  # next prepare stops at its clean-tree check.
  saved=$(mktemp)
  cp package.json "$saved"
  trap 'cp "$saved" "$root/editor/vscode/package.json"; rm -f "$saved"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  npm pkg set "version=$app_version" >&2
fi
# CI=true makes gulp leave source maps out of the bundle, as it does on any CI runner.
CI=true npm run gulp "vscode-darwin-$arch-min" >&2

bundle="$root/editor/VSCode-darwin-$arch/$(node -p 'require("./product.json").nameLong').app"
[ -d "$bundle" ] || fail "gulp did not produce $bundle"

# Renaming Electron's bundle breaks its signature, and macOS calls an unsigned or
# broken bundle damaged. #7 replaces the ad-hoc signature with a Developer ID.
codesign --force --deep --sign - "$bundle" >&2
codesign --verify --deep --strict "$bundle" >&2
APP_PATH=$bundle node build/darwin/verify-macho.ts "$arch" >/dev/null ||
  fail "$bundle has Mach-O files for the wrong architecture; see the list above"

echo "${0##*/}: built $bundle; check it with scripts/ci/check-app" >&2
printf '%s\n' "$bundle"
