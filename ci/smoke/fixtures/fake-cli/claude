#!/bin/sh
# A fake `claude` CLI for the smoke checks. Its output is synthetic, written from the documented
# stream-json format (decision record 0004), not recorded from a real run.
#
# - "auth status" answers signed in, for wispd's detection (#114), so the Accounts view's Sign in
#   action is enabled and the worker role has a default account.
# - "auth login" writes its own argv to $WISP_SIGNIN_PROOF_FILE, standing in for a completed
#   login (#115). wisp never reads this file; only the sign-in check does.
# - "--version" reports a Claude Code new enough to run a sandboxed worker (0013).
# - "-p" runs a worker turn (#105): it reads one user message from stdin, answers it, and waits
#   for stdin to close, as wispd closes it once no turn is outstanding. A task writes
#   FAKE_AGENT_NOTES.md in its worktree, so the run has a change to review; a resumed session
#   (a message sent with agent/send) echoes the message. $FAKE_CLAUDE_DELAY holds each answer
#   back a little, so the check can see the agent running.
case "${1:-} ${2:-}" in
  "auth status")
    printf '{"loggedIn":true,"subscriptionType":"Test Plan"}'
    exit 0
    ;;
  "auth login")
    if [ -n "${WISP_SIGNIN_PROOF_FILE:-}" ]; then
      printf '%s\n' "$*" >"$WISP_SIGNIN_PROOF_FILE"
    fi
    exit 0
    ;;
esac

case "${1:-}" in
  --version)
    printf '2.1.300 (Claude Code)\n'
    exit 0
    ;;
  -p) ;;
  *) exit 1 ;;
esac

resume=
previous=
for arg in "$@"; do
  if [ "$previous" = "--resume" ]; then
    resume=$arg
  fi
  previous=$arg
done

IFS= read -r line || exit 0
uuid=$(printf '%s\n' "$line" | sed -n 's/.*"uuid":"\([^"]*\)".*/\1/p')
session=${resume:-5b1e3c9a-8f2d-4c6e-9a1b-$(printf '%012d' "$$")}

emit() {
  printf '%s\n' "$1"
}

emit '{"type":"system","subtype":"init","cwd":"'"$PWD"'","session_id":"'"$session"'","tools":["Read","Edit","Write","Glob","Grep","Bash","TodoWrite"],"mcp_servers":[],"model":"claude-fake","permissionMode":"acceptEdits","apiKeySource":"none","claude_code_version":"2.1.300","uuid":"a0000000-0000-4000-8000-000000000001"}'
sleep "${FAKE_CLAUDE_DELAY:-2}"

if [ -n "$resume" ]; then
  # The message's text, from {"message":{"content":"...","role":"user"},...}; the checks send
  # plain words, so no JSON escapes need undoing.
  text=$(printf '%s\n' "$line" | sed -n 's/.*"content":"\([^"]*\)".*/\1/p')
  answer="Fake agent heard: $text"
else
  printf 'Notes from the fake agent.\n' >FAKE_AGENT_NOTES.md
  emit '{"type":"assistant","message":{"id":"msg_fake_1","type":"message","role":"assistant","model":"claude-fake","content":[{"type":"tool_use","id":"toolu_fake_write","name":"Write","input":{"file_path":"'"$PWD"'/FAKE_AGENT_NOTES.md","content":"Notes from the fake agent."}}]},"parent_tool_use_id":null,"session_id":"'"$session"'","uuid":"a0000000-0000-4000-8000-000000000002"}'
  emit '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_fake_write","type":"tool_result","content":"File created successfully.","is_error":false}]},"parent_tool_use_id":null,"session_id":"'"$session"'","uuid":"a0000000-0000-4000-8000-000000000003"}'
  answer="Fake agent wrote FAKE_AGENT_NOTES.md."
fi

emit '{"type":"assistant","message":{"id":"msg_fake_2","type":"message","role":"assistant","model":"claude-fake","content":[{"type":"text","text":"'"$answer"'"}]},"parent_tool_use_id":null,"session_id":"'"$session"'","uuid":"a0000000-0000-4000-8000-000000000004"}'
emit '{"type":"result","subtype":"success","is_error":false,"duration_ms":2000,"num_turns":1,"session_id":"'"$session"'","result":"'"$answer"'","modelUsage":{"claude-fake":{"provider":"firstParty","inputTokens":10,"outputTokens":20,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"costUSD":0}},"user_message_uuids":["'"$uuid"'"],"uuid":"a0000000-0000-4000-8000-000000000005"}'

# wispd closes stdin once no turn is outstanding; the CLI then exits.
while IFS= read -r _; do :; done
exit 0
