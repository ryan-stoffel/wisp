From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Stoffel <stoffel.thomas.ryan@gmail.com>
Date: Thu, 24 Sep 2026 20:38:10 -0700
Subject: [PATCH] wisp: serve the wispd connection from the shared process

The editor reaches wispd by spawning `wispd attach` and speaking JSON-RPC
over its stdio (wisp's decision record 0007). The renderer is sandboxed
and cannot spawn processes, so the connection lives in the shared
process, where upstream keeps its own long-lived child-process
connections: the SSH, WSL, dev container, and tunnel agent hosts, and
the remote tunnel CLI. One connection then serves every window.

WispdService and WispdChannel come from the overlay, under
src/vs/platform/wisp. This patch only registers them: the service is
created on first use, and the channel keeps request cancellation, which
ProxyChannel does not carry.

diff --git a/src/vs/code/electron-utility/sharedProcess/sharedProcessMain.ts b/src/vs/code/electron-utility/sharedProcess/sharedProcessMain.ts
index d32bf32badc887efdb4fa0233614d3f84deaf12f..b55669fe8f9b0bb176f0e90c74b0b96a95494920 100644
--- a/src/vs/code/electron-utility/sharedProcess/sharedProcessMain.ts
+++ b/src/vs/code/electron-utility/sharedProcess/sharedProcessMain.ts
@@ -74,6 +74,8 @@ import { SharedProcessUserDataProfileStorageService } from '../../../platform/us
 import { ActiveWindowManager } from '../../../platform/windows/node/windowTracker.js';
 import { ISignService } from '../../../platform/sign/common/sign.js';
 import { SignService } from '../../../platform/sign/node/signService.js';
+import { IWispdService, WISPD_CHANNEL_NAME, WispdChannel } from '../../../platform/wisp/common/wispd.js';
+import { WispdService } from '../../../platform/wisp/node/wispdService.js';
 import { ISharedTunnelsService } from '../../../platform/tunnel/common/tunnel.js';
 import { SharedTunnelsService } from '../../../platform/tunnel/node/tunnelService.js';
 import { ipcSharedProcessTunnelChannelName, ISharedProcessTunnelService } from '../../../platform/remote/common/sharedProcessTunnelService.js';
@@ -404,6 +406,9 @@ class SharedProcessMain extends Disposable implements IClientConnectionFilter {
 		// Signing
 		services.set(ISignService, new SyncDescriptor(SignService, undefined, false /* proxied to other processes */));
 
+		// wisp: the connection to wispd
+		services.set(IWispdService, new SyncDescriptor(WispdService, undefined, true));
+
 		// Tunnel
 		const remoteSocketFactoryService = new RemoteSocketFactoryService();
 		services.set(IRemoteSocketFactoryService, remoteSocketFactoryService);
@@ -462,6 +467,9 @@ class SharedProcessMain extends Disposable implements IClientConnectionFilter {
 		const checksumChannel = ProxyChannel.fromService(accessor.get(IChecksumService), this._store);
 		this.server.registerChannel('checksum', checksumChannel);
 
+		// wisp: the connection to wispd
+		this.server.registerChannel(WISPD_CHANNEL_NAME, new WispdChannel(accessor.get(IWispdService)));
+
 		// Profiling
 		const profilingChannel = ProxyChannel.fromService(accessor.get(IV8InspectProfilingService), this._store);
 		this.server.registerChannel('v8InspectProfiling', profilingChannel);
