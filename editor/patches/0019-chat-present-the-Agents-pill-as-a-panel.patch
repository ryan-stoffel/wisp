 import { ActionListItemKind, IActionListDelegate, IActionListItem } from '../../platform/actionWidget/browser/actionList.js';
@@ -55,6 +56,20 @@ export interface IChatDropdownPillOptions {
 	readonly singleEntry?: ChatPillSingleEntry;
 }
 
+/** A panel that replaces a pill's summary and dropdown, registered by the pill's widget id. */
+export interface IChatPillPanel {
+	summary(entries: readonly IChatPillEntry[]): { readonly label: string; readonly icon?: ThemeIcon; readonly trailing?: readonly HTMLElement[]; readonly ariaLabel: string };
+	/** Shows the panel for `trigger`; it calls `onDidHide` once it closes. Disposing it closes it. */
+	show(trigger: HTMLElement, sections: IObservable<readonly IChatPillSection[]>, onDidHide: () => void): IDisposable;
+}
+
+const chatPillPanels = new Map<string, IChatPillPanel>();
+
+export function registerChatPillPanel(widgetId: string, panel: IChatPillPanel): IDisposable {
+	chatPillPanels.set(widgetId, panel);
+	return toDisposable(() => chatPillPanels.get(widgetId) === panel && chatPillPanels.delete(widgetId));
+}
+
 /**
  * The entry a pill shows in place of its summary, or `undefined` when it
  * summarizes. The single place {@link IChatDropdownPillOptions.singleEntry} is
@@ -66,6 +81,9 @@ function getInlineEntry(entries: readonly IChatPillEntry[], options: IChatDropdo
 		return undefined;
 	}
 	const entry = entries[0];
+	if (chatPillPanels.has(options.widgetId)) {
+		return undefined;
+	}
 	switch (options.singleEntry ?? ChatPillSingleEntry.Inline) {
 		case ChatPillSingleEntry.Inline: return entry;
 		case ChatPillSingleEntry.InlineResource: return entry.resource ? entry : undefined;
